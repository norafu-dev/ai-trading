POSTGRES_DB=ai_copy_trading
POSTGRES_USER=ai_copy_trading
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+asyncpg://ai_copy_trading:replace_with_a_local_password@localhost:5432/ai_copy_trading

# Official Discord bot credentials. The bot must be invited to the target server
# and have View Channel / Read Message History permissions. Never commit a token.
DISCORD_BOT_TOKEN=replace_with_a_discord_bot_token
DISCORD_CHANNEL_IDS=123456789012345678
# Optional comma-separated author allowlist. Empty means all authors in the channels.
DISCORD_AUTHOR_IDS=
